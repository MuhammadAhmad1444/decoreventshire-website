# Decor Events Hire — Apache config for the static export (Hostinger)

RewriteEngine On

# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://decoreventshire.com.au%{REQUEST_URI} [L,R=301]

# Block private data and repo files
RewriteRule ^private(/|$) - [F,L]
RewriteRule (^|/)\.git(/|$) - [F,L]

# Old product pages from earlier versions of the plinth and skirting range: send them to the current page.
RewriteRule ^product/small-black-acrylic-square-plinth/?$ /product/black-acrylic-square-plinth/ [L,R=301]
RewriteRule ^product/medium-black-acrylic-square-plinth/?$ /product/black-acrylic-square-plinth/ [L,R=301]
RewriteRule ^product/large-black-acrylic-square-plinth/?$ /product/black-acrylic-square-plinth/ [L,R=301]
RewriteRule ^product/x-large-white-cake-plinth-table/?$ /product/x-large-cake-plinth-table/ [L,R=301]
RewriteRule ^product/x-large-black-cake-plinth-table/?$ /product/x-large-cake-plinth-table/ [L,R=301]
RewriteRule ^product/x-large-clear-cake-plinth-table/?$ /product/x-large-cake-plinth-table/ [L,R=301]
RewriteRule ^product/clear-acrylic-plinth-set-3/?$ /product/large-clear-acrylic-square-plinth/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-burgundy-swag/?$ /product/3m-white-satin-table-skirting-with-red-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-baby-pink-swag/?$ /product/3m-white-satin-table-skirting-with-pink-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-hot-pink-swag/?$ /product/3m-white-satin-table-skirting-with-pink-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-light-blue-swag/?$ /product/3m-white-satin-table-skirting-with-blue-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-royal-blue-swag/?$ /product/3m-white-satin-table-skirting-with-blue-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-navy-blue-swag/?$ /product/3m-white-satin-table-skirting-with-blue-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-silver-swag/?$ /product/3m-white-satin-table-skirting-with-gold-or-silver-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-gold-swag/?$ /product/3m-white-satin-table-skirting-with-gold-or-silver-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-lavender-swag/?$ /product/3m-white-satin-table-skirting-with-purple-swag/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-dark-purple-swag/?$ /product/3m-white-satin-table-skirting-with-purple-swag/ [L,R=301]
RewriteRule ^product/white-square-plinth/?$ /product/large-white-square-plinth-90cm/ [L,R=301]
RewriteRule ^product/gloss-white-ripple-plinth/?$ /product/gloss-white-ripple-plinth-110cm/ [L,R=301]
RewriteRule ^product/white-round-plinth/?$ /product/large-white-round-plinth-90cm/ [L,R=301]
RewriteRule ^product/clear-acrylic-square-plinth/?$ /product/large-clear-acrylic-square-plinth/ [L,R=301]
RewriteRule ^product/white-satin-table-skirting/?$ /product/3m-white-satin-table-skirting/ [L,R=301]
RewriteRule ^product/black-polyester-table-skirting/?$ /product/6m-black-polyester-table-skirting/ [L,R=301]
RewriteRule ^product/3m-white-satin-table-skirting-with-swag/?$ /product/3m-white-satin-table-skirting-with-red-swag/ [L,R=301]

# Products no longer offered: send them to their category.
RewriteRule ^product/plinth-set/?$ /hire/plinths/ [L,R=301]
RewriteRule ^product/table-runner/?$ /hire/table-runners/ [L,R=301]
RewriteRule ^product/kids-gladiator-chair/?$ /hire/chairs/ [L,R=301]

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Photos keep their names when replaced, so cache for 30 days and refresh quietly in the background.
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp|svg|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>
</IfModule>

# Build files under /_next/static have content hashes in their names, so they never change: cache for a year.
<If "%{REQUEST_URI} =~ m#^/_next/static/#">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</If>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
